# ==============================================================================
# Suricata 8.0.6 Official Custom Rules - Web Application Attacks
# SID Range: 9010000 - 9019999
# Reference: SOC Detection & Monitoring Lab LLD v1.0
# ==============================================================================

# 1. SQL Injection (SQLi)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web SQL Injection - UNION SELECT Pattern Attempt"; flow:established,to_server; http.uri; content:"union",nocase; http.uri; content:"select",nocase,distance:1; pcre:"/\bunion\b(?:\s|\/\*.*?\*\/|\+)+(?:all\s+)?\bselect\b/i"; classtype:web-application-attack; sid:9010001; rev:2; metadata:attack_technique T1190, severity High, stage Initial_Access;)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web SQL Injection - Boolean or Time-Based Injection Attempt"; flow:established,to_server; http.uri; pcre:"/(?:'|%27)\s*\b(or|and)\b\s*(?:\d+=\d+|sleep\s*\(\s*\d+\s*\))/i"; classtype:web-application-attack; sid:9010002; rev:2; metadata:attack_technique T1190, severity High, stage Initial_Access;)

# 2. Cross-Site Scripting (XSS)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web Cross-Site Scripting - Script Tag in URI Query Attempt"; flow:established,to_server; http.uri; pcre:"/<script[^>]*>|%3Cscript/i"; classtype:web-application-attack; sid:9010010; rev:2; metadata:attack_technique T1189, severity Medium, stage Initial_Access;)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web Cross-Site Scripting - Event Handler Injected Attempt"; flow:established,to_server; http.uri; pcre:"/(onload|onerror|onclick|onmouseover)\s*=/i"; classtype:web-application-attack; sid:9010011; rev:2; metadata:attack_technique T1189, severity Medium, stage Initial_Access;)

# 3. Path Traversal & LFI
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web Path Traversal - Directory Escalation (../) Attempt"; flow:established,to_server; http.uri; pcre:"/(?:\.\.[/\\]|%2e%2e(?:%2f|%5c|\/|\\)|\.\.%2f|\.\.%5c)/i"; classtype:web-application-attack; sid:9010020; rev:2; metadata:attack_technique T1083, severity High, stage Initial_Access;)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web LFI - Sensitive Credential File (/etc/passwd) Access Attempt"; flow:established,to_server; http.uri; content:"/etc/passwd"; classtype:web-application-attack; sid:9010021; rev:2; metadata:attack_technique T1083, severity High, stage Initial_Access;)

# 4. Remote Code Execution (RCE) / Log4j JNDI Exploit
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Remote Code Execution - Apache Log4j JNDI Exploit Attempt (${jndi:})"; flow:established,to_server; content:"${jndi:",nocase,fast_pattern; pcre:"/\$\{jndi:(ldap|rmi|dns|nis|iiop|corba):\/\//i"; classtype:attempted-admin; sid:9010040; rev:2; metadata:attack_technique T1190, cve CVE-2021-44228, severity Critical, stage Initial_Access;)
