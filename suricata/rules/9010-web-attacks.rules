# ==============================================================================
# Suricata 8.0.6 Official Custom Rules - Web Application Attacks
# SID Range: 9010000 - 9019999
# Reference: SOC Detection & Monitoring Lab LLD v1.0
# ==============================================================================

# 1. SQL Injection (SQLi)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web SQL Injection - UNION SELECT Pattern Detected"; flow:established,to_server; http.uri; content:"union",nocase; content:"select",nocase; classtype:web-application-attack; sid:9010001; rev:1; metadata:attack_technique T1190, severity High, stage Initial_Access;)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web SQL Injection - Boolean Based Slept Or True Condition"; flow:established,to_server; http.uri; pcre:"/('|\%27)\s*(or|and)\s*(\d+=\d+|sleep\(\d+\))/i"; classtype:web-application-attack; sid:9010002; rev:1; metadata:attack_technique T1190, severity High, stage Initial_Access;)

# 2. Cross-Site Scripting (XSS)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web Cross-Site Scripting - Script Tag in URI Query"; flow:established,to_server; http.uri; pcre:"/<script[^>]*>|%3Cscript/i"; classtype:web-application-attack; sid:9010010; rev:1; metadata:attack_technique T1189, severity Medium, stage Initial_Access;)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web Cross-Site Scripting - Event Handler Injected"; flow:established,to_server; http.uri; pcre:"/(onload|onerror|onclick|onmouseover)\s*=/i"; classtype:web-application-attack; sid:9010011; rev:1; metadata:attack_technique T1189, severity Medium, stage Initial_Access;)

# 3. Path Traversal & LFI
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web Path Traversal - Directory Escalation (../) Attempt"; flow:established,to_server; http.uri; pcre:"/(\.\.\/|\.\.\\|%2e%2e%2f|%2e%2e\/)/i"; classtype:web-application-attack; sid:9010020; rev:1; metadata:attack_technique T1083, severity High, stage Initial_Access;)
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Web LFI - Sensitive Credential File (/etc/passwd) Access"; flow:established,to_server; http.uri; content:"/etc/passwd"; classtype:web-application-attack; sid:9010021; rev:1; metadata:attack_technique T1083, severity Critical, stage Initial_Access;)

# 4. Remote Code Execution (RCE) / Log4j JNDI Exploit
alert http any any -> $HOME_NET [80,443,3000,8080] (msg:"SOC-ATTACK: Remote Code Execution - Apache Log4j JNDI Lookup (${jndi:})"; flow:established,to_server; http.header; pcre:"/\$\{jndi:(ldap|rmi|dns|nis|iiop|corba):\/\//i"; classtype:attempted-admin; sid:9010040; rev:1; metadata:attack_technique T1190, cve CVE-2021-44228, severity Critical, stage Initial_Access;)
