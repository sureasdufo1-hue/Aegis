# ==============================================================================
# Suricata 8.0.6 Official Custom Rules - Authentication & Brute Force
# SID Range: 9020000 - 9029999
# Reference: SOC Detection & Monitoring Lab LLD v1.0
# ==============================================================================

# 1. SSH Connection Threshold Rate Limiting (Network Connection Anomaly, not Auth Failure)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SOC-ANOMALY: High-Frequency SSH Connection Threshold Exceeded (Potential Brute Force Attempt)"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 30; classtype:attempted-admin; sid:9020001; rev:2; metadata:attack_technique T1110, severity Medium, confidence Low, stage Credential_Access_Attempt;)

# 2. Web HTTP Basic / Form Auth POST Volume Anomaly
alert http $EXTERNAL_NET any -> $HOME_NET [80,443,3000] (msg:"SOC-ANOMALY: High-Volume HTTP POST to Login Endpoint (Potential Web Auth Brute Force)"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/login"; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:9020010; rev:2; metadata:attack_technique T1110.001, severity Medium, confidence Low, stage Credential_Access_Attempt;)
