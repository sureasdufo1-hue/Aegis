# ==============================================================================
# Web Application Attacks Rules (Suricata 7.x)
# ==============================================================================

# 1. SQL Injection (SQLi)
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Web SQL Injection - UNION SELECT Attempt"; flow:established,to_server; http.uri; content:"union",nocase; content:"select",nocase; classtype:web-application-attack; sid:1000001; rev:1; metadata:attack_technique T1190, severity High;)
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Web SQL Injection - Boolean Based (1=1 or sleep)"; flow:established,to_server; http.uri; pcre:"/('|\%27)\s*(or|and)\s*(\d+=\d+|sleep\(\d+\))/i"; classtype:web-application-attack; sid:1000002; rev:1; metadata:attack_technique T1190, severity High;)

# 2. Cross-Site Scripting (XSS)
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Web Cross-Site Scripting - Script Tag in URI"; flow:established,to_server; http.uri; pcre:"/<script[^>]*>|%3Cscript/i"; classtype:web-application-attack; sid:1000010; rev:1; metadata:attack_technique T1189, severity Medium;)
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Web Cross-Site Scripting - Event Handler Injection"; flow:established,to_server; http.uri; pcre:"/(onload|onerror|onclick|onmouseover)\s*=/i"; classtype:web-application-attack; sid:1000011; rev:1; metadata:attack_technique T1189, severity Medium;)

# 3. Path Traversal & LFI
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Web Path Traversal - Directory Traversal (../) Attempt"; flow:established,to_server; http.uri; pcre:"/(\.\.\/|\.\.\\|%2e%2e%2f|%2e%2e\/)/i"; classtype:web-application-attack; sid:1000020; rev:1; metadata:attack_technique T1083, severity High;)
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Web LFI - Sensitive File (/etc/passwd) Access Attempt"; flow:established,to_server; http.uri; content:"/etc/passwd"; classtype:web-application-attack; sid:1000021; rev:1; metadata:attack_technique T1083, severity Critical;)

# 4. Remote Code Execution (RCE) & Command Injection
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Web Command Injection - Shell Execution via Parameter"; flow:established,to_server; http.uri; pcre:"/(;|\||`|\$\().*(whoami|id|uname|cat\s+\/etc|cmd\.exe|powershell)/i"; classtype:attempted-admin; sid:1000030; rev:1; metadata:attack_technique T1059, severity Critical;)

# 5. Log4j / Log4Shell (CVE-2021-44228)
alert http any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-ATTACK: Remote Code Execution - Apache Log4j JNDI Lookup (${jndi:})"; flow:established,to_server; http.header; pcre:"/\$\{jndi:(ldap|rmi|dns|nis|iiop|corba):\/\//i"; classtype:attempted-admin; sid:1000040; rev:1; metadata:attack_technique T1190, cve CVE-2021-44228, severity Critical;)
