# ==============================================================================
# Snort 3 Local & Custom Rules
# ==============================================================================

# ICMP
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-INFO: ICMP Ping Echo Request"; itype:8; icode:0; classtype:misc-activity; sid:2000001; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-ATTACK: ICMP Ping Flood"; itype:8; icode:0; detection_filter:track by_src, count 20, seconds 5; classtype:denial-of-service; sid:2000002; rev:1;)

# Web SQL Injection
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SNORT-ATTACK: Web SQL Injection UNION SELECT"; flow:to_server,established; http_uri; content:"union",nocase; content:"select",nocase; classtype:web-application-attack; sid:2000010; rev:1;)
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SNORT-ATTACK: Web Cross-Site Scripting Script Tag"; flow:to_server,established; http_uri; pcre:"/<script[^>]*>|%3Cscript/i"; classtype:web-application-attack; sid:2000011; rev:1;)
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SNORT-ATTACK: Web Path Traversal /etc/passwd"; flow:to_server,established; http_uri; content:"/etc/passwd"; classtype:web-application-attack; sid:2000012; rev:1;)
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SNORT-ATTACK: Apache Log4j JNDI RCE Attempt"; flow:to_server,established; http_header; pcre:"/\$\{jndi:(ldap|rmi|dns):\/\//i"; classtype:attempted-admin; sid:2000013; rev:1;)

# Scans
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-SCAN: Nmap Stealth NULL Scan"; flags:0; classtype:attempted-recon; sid:2000020; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-SCAN: Nmap Stealth XMAS Scan"; flags:FPU; classtype:attempted-recon; sid:2000021; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-SCAN: Nmap Stealth FIN Scan"; flags:F; classtype:attempted-recon; sid:2000022; rev:1;)

# C2 & Reverse Shell
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444:9999 (msg:"SNORT-MALWARE: Interactive Reverse Shell /bin/sh"; flow:from_server,established; content:"/bin/sh"; classtype:trojan-activity; sid:2000030; rev:1;)
