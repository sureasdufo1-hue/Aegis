# ==============================================================================
# Snort 3 / Snort 2.9 Official Custom Rules - Offline Validation & Comparison
# SID Range: 9100000 - 9199999
# Reference: SOC Detection & Monitoring Lab LLD v1.0
# ==============================================================================

# 1. ICMP
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-INFO: ICMP Ping Echo Diagnostic"; itype:8; icode:0; classtype:misc-activity; sid:9100001; rev:2;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-ATTACK: ICMP Ping Flood Denial of Service"; itype:8; icode:0; threshold:type both, track by_src, count 25, seconds 5; classtype:denial-of-service; sid:9100002; rev:2;)

# 2. Web Attacks
alert tcp any any -> $HOME_NET [80,443,3000,8080] (msg:"SNORT-ATTACK: Web SQL Injection UNION SELECT Pattern Attempt"; flow:to_server,established; content:"union",nocase; content:"select",nocase,distance:1; classtype:web-application-attack; sid:9100010; rev:2;)
alert tcp any any -> $HOME_NET [80,443,3000,8080] (msg:"SNORT-ATTACK: Web Cross-Site Scripting Script Tag Attempt"; flow:to_server,established; pcre:"/<script[^>]*>|%3Cscript/i"; classtype:web-application-attack; sid:9100011; rev:2;)
alert tcp any any -> $HOME_NET [80,443,3000,8080] (msg:"SNORT-ATTACK: Web LFI /etc/passwd Access Attempt"; flow:to_server,established; content:"/etc/passwd"; classtype:web-application-attack; sid:9100012; rev:2;)
alert tcp any any -> $HOME_NET [80,443,3000,8080] (msg:"SNORT-ATTACK: Apache Log4j JNDI RCE Exploit Attempt (${jndi:})"; flow:to_server,established; pcre:"/\$\{jndi:(ldap|rmi|dns):\/\//i"; classtype:attempted-admin; sid:9100013; rev:2;)

# 3. Scans
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-SCAN: Nmap Stealth NULL Scan (No Flags)"; flags:0; classtype:attempted-recon; sid:9100020; rev:2;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-SCAN: Nmap Stealth XMAS Scan (FPU Flags)"; flags:FPU; classtype:attempted-recon; sid:9100021; rev:2;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SNORT-SCAN: Nmap Stealth FIN Scan"; flags:F; classtype:attempted-recon; sid:9100022; rev:2;)

# 4. Malware C2 & Reverse Shell
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444:9999 (msg:"SNORT-MALWARE: Potential Interactive Reverse Shell /bin/sh Output"; flow:from_server,established; content:"/bin/sh"; classtype:trojan-activity; sid:9100030; rev:2;)
