# ==============================================================================
# SOC Detection & Monitoring Lab - Environment Variables Example Template
# NOTE: Never commit actual secrets or production passwords (.env) to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Wazuh 4.14.7 SIEM Credentials (Change in your local .env)
# ------------------------------------------------------------------------------
WAZUH_INDEXER_ADMIN_PASSWORD=SocLabSecret2026!Wazuh
WAZUH_API_USER=admin
WAZUH_API_PASSWORD=SocLabSecret2026!Wazuh
WAZUH_DASHBOARD_PORT=443

# ------------------------------------------------------------------------------
# Network Topology Baseline
# ------------------------------------------------------------------------------
GATEWAY_MGMT_IP=10.77.10.1
GATEWAY_ATTACK_IP=10.77.20.1
GATEWAY_VICTIM_IP=10.77.30.1

ATTACKER_IP=10.77.20.20
VICTIM_IP=10.77.30.20
SENSOR_MGMT_IP=10.77.10.20
HOST_MGMT_IP=10.77.10.10

# ------------------------------------------------------------------------------
# IDS / Sensor Configuration
# ------------------------------------------------------------------------------
SURICATA_EVE_LOG=/var/log/suricata/eve.json
SNORT_ALERT_LOG=/var/log/snort/alert_json.txt
SENSOR_MONITOR_IFACE=eth1

# ------------------------------------------------------------------------------
# SOC Web Dashboard
# ------------------------------------------------------------------------------
SOC_DASHBOARD_HOST=0.0.0.0
SOC_DASHBOARD_PORT=8501

# ------------------------------------------------------------------------------
# SOAR Real-Time Incident Webhooks & Dispatcher
# ------------------------------------------------------------------------------
AEGIS_SLACK_WEBHOOK_URL=
AEGIS_DISCORD_WEBHOOK_URL=
AEGIS_ALERT_WEBHOOK_URL=
AEGIS_ALERT_COOLDOWN_MINUTES=10
AEGIS_DASHBOARD_URL=http://10.77.10.10:8501
AEGIS_ALERT_DRY_RUN=false
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
